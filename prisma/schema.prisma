generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   Int          @id @default(autoincrement())
  username             String       @unique
  email                String?      @unique
  profileImageFilename String?      @map("profile_image_filename")
  bannerImageFilename  String?      @map("banner_image_filename")
  createdAt            DateTime     @default(now()) @map("created_at")
  credentials Credential[]
  profileWidgets       ProfileWidget[]

  @@map("users")
}

model ProfileWidget {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  widgetType      String   @map("widget_type")
  position        Int
  configuration   String   @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, widgetType])
  @@index([userId, position])
  @@map("profile_widgets")
}

model Credential {
  credentialId   String    @id @map("cred_id")
  friendlyName   String    @default("Passkey") @map("friendly_name")
  publicKey      Bytes     @map("cred_public_key")
  internalUserId Int       @map("internal_user_id")
  webauthnUserId String    @map("webauthn_user_id")
  counter        Int       @default(0)
  backupEligible Boolean   @default(false) @map("backup_eligible")
  backupStatus   Boolean   @default(false) @map("backup_status")
  transports     String?
  createdAt      DateTime  @default(now()) @map("created_at")
  lastUsed       DateTime? @map("last_used")

  user User @relation(fields: [internalUserId], references: [id])

  @@unique([internalUserId, webauthnUserId])
  @@index([internalUserId, credentialId])
  @@index([webauthnUserId, credentialId])
  @@map("passkeys")
}
