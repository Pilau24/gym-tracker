{
  "show_edit_predictions": false,
  "context_servers": {
    "io.github.ChromeDevTools/chrome-devtools-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.9.0"
      ],
      "x-metadata": {
        "registry": {
          "api": {
            "baseUrl": "https://api.mcp.github.com",
            "version": "v0.1"
          },
          "mcpServer": {
            "name": "io.github.ChromeDevTools/chrome-devtools-mcp",
            "version": "1.9.0"
          }
        }
      }
    },
    "org.nextjs.mcp": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "com.shadcn.mcp": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "shadcn@latest",
        "mcp"
      ]
    },
    "io.reui.copilot": {
      "type": "http",
      "url": "https://mcp.reui.io"
    }
  }
}
