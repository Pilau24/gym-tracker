{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "io.github.ChromeDevTools/chrome-devtools-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.9.0"
      ],
      "x-metadata": {
        "registry": {
          "api": {
            "baseUrl": "https://api.mcp.github.com",
            "version": "v0.1"
          },
          "mcpServer": {
            "name": "io.github.ChromeDevTools/chrome-devtools-mcp",
            "version": "1.9.0"
          }
        }
      }
    },
    "firefox-devtools": {
      "command": "pnx",
      "args": [
        "--allow-build=geckodriver@6.0.2",
        "@mozilla/firefox-devtools-mcp@latest",
        "--tool-preset developer",
        "--connect-existing --marionette-port 2828"
      ]
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ],
      "type": "stdio"
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ],
      "type": "stdio"
    },
    "io.reui.copilot": {
      "type": "http",
      "url": "https://mcp.reui.io"
    }
  }
}
